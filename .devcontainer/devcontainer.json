{
    "name": "Windows 11 + KVM + Tailscale RDP",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "mounts": [
        "source=var-lib-docker,target=/var/lib/docker,type=volume"
    ],
    "forwardPorts": [
        8006
    ],
    "portsAttributes": {
        "8006": {
            "label": "Windows setup console",
            "protocol": "http",
            "onAutoForward": "notify"
        }
    },
    "capAdd": [
        "ALL"
    ],
    "securityOpt": [
        "seccomp=unconfined"
    ],
    "privileged": true,
    "init": true,
    "containerUser": "root",
    "remoteUser": "root",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/github,type=bind,consistency=cached",
    "workspaceFolder": "/workspaces/github",
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "onCreateCommand": "bash .devcontainer/onCreateCommand.sh",
    "postStartCommand": "bash .devcontainer/postStartCommand.sh",
    "waitFor": "postStartCommand"
}
